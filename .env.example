# Copy to .env and fill in. .env is NOT committed to git.
POSTGRES_DB=smart_elephant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Locally ":80". On the server: your domain, e.g. game.example.com (Caddy gets HTTPS automatically)
SITE_ADDRESS=:80
# Change if port 80 is busy on your computer (then open http://localhost:8081)
HTTP_PORT=80

CLAUDE_API_KEY=
